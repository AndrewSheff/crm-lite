# ======================================
# CRM Lite — переменные окружения
# ======================================

# --- Database ---
DB_USER=crm_user
DB_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+asyncpg://crm_user:CHANGE_ME@postgres:5432/crm_lite

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Security (JWT) ---
# Сгенерируй: openssl rand -hex 32
SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Дефолтный админ ---
ADMIN_EMAIL=admin@crm-lite.local
ADMIN_PASSWORD=CHANGE_ME

# --- AI (опционально) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=anthropic

# --- CORS ---
CORS_ORIGINS=http://localhost

# --- Приложение ---
DEBUG=false
APP_VERSION=1.0.0
APP_PORT=80
